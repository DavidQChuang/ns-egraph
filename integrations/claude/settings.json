{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR/.ns-egraph/tool\" && python3 -B -m integrations.claude.hook ../graphs",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR/.ns-egraph/tool\" && python3 -B -m integrations.claude.hook ../graphs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
