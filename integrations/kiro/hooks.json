{
  "version": "v1",
  "hooks": [
    {
      "name": "Recall exploration context",
      "trigger": "UserPromptSubmit",
      "action": {
        "type": "command",
        "command": "python3 -B \".ns-egraph/tool/integrations\" kiro"
      },
      "timeout": 5
    },
    {
      "name": "Resume exploration checkpoint",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "python3 -B \".ns-egraph/tool/integrations\" kiro"
      },
      "timeout": 5
    },
    {
      "name": "Restore exploration checkpoint after compaction",
      "trigger": "PostCompact",
      "action": {
        "type": "command",
        "command": "python3 -B \".ns-egraph/tool/integrations\" kiro"
      },
      "timeout": 5
    }
  ]
}
